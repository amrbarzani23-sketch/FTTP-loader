<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Xbox Cloud - Void Booster</title>
  <style>
    body {
      margin: 0;
      height: 100vh;
      background: #000000;
      overflow: hidden;
      font-family: Arial, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: white;
    }
    .void-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle, #1a0033 0%, #000000 80%);
      animation: pulseVoid 4s infinite alternate;
      z-index: -1;
    }
    @keyframes pulseVoid {
      0% { transform: scale(1); opacity: 0.8; }
      100% { transform: scale(1.1); opacity: 1; }
    }
    h1 {
      font-size: 26px;
      margin-bottom: 8px;
      text-shadow: 0 0 10px #8a2be2;
    }
    p {
      color: #b19cd9;
      margin-bottom: 30px;
      font-size: 14px;
    }
    .load-btn {
      background: #107C41;
      color: white;
      font-size: 22px;
      font-weight: bold;
      padding: 16px 36px;
      border: 3px solid #ffffff;
      border-radius: 12px;
      cursor: pointer;
      box-shadow: 0 0 20px rgba(16, 124, 65, 0.8);
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div class="void-bg"></div>

  <h1>Xbox Cloud Gaming - Void Boost</h1>
  <p>Optimizing session stability & RAM for PS4...</p>

  <a href="https://www.xbox.com/play" class="load-btn" id="boostBtn">Press X to Load Boost & Play</a>

  <script>
    // Automatically focus button so pressing X on PS4 controller activates it
    window.onload = function() {
      document.getElementById("boostBtn").focus();
    };
  </script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>PSBox Cloud Gaming</title>
  <style>
    body {
      margin: 0;
      height: 100vh;
      background: #05050a url('https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=1920&auto=format&fit=crop') no-repeat center center fixed;
      background-size: cover;
      font-family: Arial, sans-serif;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
      padding-bottom: 10vh;
      color: white;
      overflow: hidden;
    }
    .overlay {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1;
    }
    .content {
      position: relative;
      z-index: 2;
      text-align: center;
    }
    h1 {
      font-size: 32px;
      margin-bottom: 5px;
      text-shadow: 0 2px 10px rgba(0,0,0,0.9);
    }
    p {
      color: #b19cd9;
      font-size: 14px;
      margin-bottom: 25px;
      text-shadow: 0 1px 5px rgba(0,0,0,0.9);
    }
    .launch-btn {
      background: #107C41;
      color: white;
      font-size: 22px;
      font-weight: bold;
      padding: 18px 45px;
      border: 3px solid #ffffff;
      border-radius: 8px;
      cursor: pointer;
      box-shadow: 0 0 25px rgba(16, 124, 65, 0.9);
      text-decoration: none;
      display: inline-block;
      transition: 0.2s;
    }
    .launch-btn:focus, .launch-btn:hover {
      background: #0e6d39;
      transform: scale(1.05);
      outline: none;
    }

    /* System Notification (Matches native PS4 GoldHEN popup location) */
    #ps4-notification {
      position: fixed;
      top: 20px;
      left: -400px; /* Hidden off-screen to the left */
      background: rgba(20, 24, 30, 0.95);
      border-left: 5px solid #107C41;
      color: #ffffff;
      padding: 14px 22px;
      border-radius: 6px;
      box-shadow: 0 8px 25px rgba(0,0,0,0.9);
      z-index: 999;
      font-size: 14px;
      transition: left 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    #ps4-notification b {
      color: #107C41;
      display: block;
      font-size: 15px;
      margin-bottom: 2px;
    }
  </style>
</head>
<body>
  <div class="overlay"></div>

  <!-- GoldHEN System Style Popup (Top-Left) -->
  <div id="ps4-notification">
    <b>GoldHEN MS Boost Loaded</b>
    Latency locked ~60ms • RAM Stabilized
  </div>

  <div class="content">
    <h1>PSBox Cloud Gaming</h1>
    <p>Handcrafted Native Web Wrapper v1.20 • 60ms Target Route</p>
    <a href="https://www.xbox.com/play" class="launch-btn" id="xBtn" onclick="triggerBoost(event)">Press X to Load Boost & Play</a>
  </div>

  <script>
    // Focus button on page load so pressing X immediately activates it
    window.onload = function() {
      document.getElementById("xBtn").focus();
    };

    function triggerBoost(e) {
      e.preventDefault();
      var notif = document.getElementById("ps4-notification");
      
      // Slide in from top-left like real PS4 notification
      notif.style.left = "20px";
      
      // Redirect after showing notification
      setTimeout(function() {
        window.location.href = "https://www.xbox.com/play";
      }, 1600);
    }
  </script>
</body>
</html>
